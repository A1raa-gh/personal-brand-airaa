1. Analisis Statistik Deskriptif Profil Data Responden

{r}
#| warning: FALSE
#| echo: FALSE
#| output: FALSE

# Data Respondent
respondent_data <- wvsidn |>
  dplyr::select(Q260, Q262, X003R, H_URBRURAL, Q275) |>
  mutate(
    gender = dplyr::recode(Q260, `1` = "Laki-laki", `2` = "Perempuan"),
    age = Q262,
    age_group = dplyr::recode(X003R,
                           `1` = "18-24", `2` = "25-34", `3` = "35-44",
                           `4` = "45-54", `5` = ">55", `6` = ">55"),
    living_area = dplyr::recode(H_URBRURAL,
                                    `1` = "Perkotaan", `2` = "Pedesaan"),
    education = dplyr::recode(Q275,
                        `0` = "Tidak sekolah/TK", `1` = "SD", `2` = "SMP",
                        `3` = "SMA", `5` = "Perguruan Tinggi", 
                        `6` = "Perguruan Tinggi", `7` = "Perguruan Tinggi", 
                        `8` = "Perguruan Tinggi")
  ) |>
  mutate(education = factor(education,
                             levels = c("Tidak sekolah/TK","SD","SMP","SMA",
                                        "Perguruan Tinggi")),
  ) |>
  dplyr::select(gender, age, age_group, living_area, education) |>
  drop_na()

{r}
#| warning: FALSE
#| echo: FALSE
#| output: FALSE

# Table Respondent
respondent_table <- bind_rows(
  respondent_data |> 
    count(Kategori = gender) |> 
    mutate(Indikator = "Jenis Kelamin"),
  respondent_data |> 
    count(Kategori = age_group) |> 
    mutate(Indikator = "Kelompok Usia"),
  respondent_data |> 
    count(Kategori = living_area) |> 
    mutate(Indikator = "Wilayah Tinggal"),
  respondent_data |> 
    count(Kategori = education) |> 
    mutate(Indikator = "Pendidikan Terakhir")
) |> 
  filter(!is.na(Kategori)) |> 
  rename(Jumlah = n) |> 
  group_by(Indikator) |> 
  mutate(Persen = round(Jumlah / sum(Jumlah) * 100, 1)) |> 
  ungroup() |> 
  mutate(
    Indikator = ifelse(duplicated(Indikator), "", Indikator)
) |> 
  dplyr::select(Indikator, Kategori, Jumlah, Persen)

{r}
#| warning: FALSE
#| echo: FALSE
#| output: TRUE
#| tbl-cap: "Distribusi Data Responden"
#| label: tbl-1

# Tabel Deskriptif Data Responden
ft_respondent <- flextable(respondent_table) |> 
  set_header_labels(
    Indikator = "Indikator", 
    Kategori = "Kategori", 
    Jumlah = "Jumlah", 
    Persen = "Persen (%)"
  ) |>
  set_table_properties(layout = "autofit", width = 0.95) 

ft_respondent

Berdasarkan data pada @tbl-1, mayoritas responden merupakan perempuan (54,9%) dan tinggal di wilayah pedesaan (74,1%). Selanjutnya, distribusi kelompok usia menunjukkan proporsi yang hampir seimbang antara kelompok 25-34 tahun (25,5%) dan 35-44 tahun (25,6%). Dilihat dari pendidikan terakhir, mayoritas responden berpendidikan hingga Sekolah Menengah Atas (SMA) dengan persentase sebesar (33,4%). Data ini memberikan gambaran umum karakteristik responden survei WVS di Indonesia yang digunakan sebagai data analisis dalam penelitian ini.

2. Analisis Statistik Deskriptif Data Kesejahteraan Sosial

{r}
#| warning: FALSE
#| echo: FALSE
#| output: FALSE

# Dataset Wellbeing
wellbeing <- wvsidn |>
  dplyr::select(
    level_of_happiness = Q46,
    health_status = Q47,
    freedom_of_choice = Q48,
    life_satisfaction = Q49,
    household_financial_satisfaction = Q50
  ) |>
  mutate(across(everything(), ~ na_if(.x, -1))) |>
  mutate(across(everything(), ~ na_if(.x, -2))) |>
  mutate(across(everything(), ~ na_if(.x, -5))) |>
  mutate(
    level_of_happiness = dplyr::recode(level_of_happiness, 
      `1` = 4, `2` = 3, `3` = 2, `4` = 1, .default = NA_real_),
    health_status = dplyr::recode(health_status,
      `1` = 5, `2` = 4, `3` = 3, `4` = 2, `5` = 1, .default = NA_real_)
  ) 

{r}
#| warning: FALSE
#| echo: FALSE
#| output: FALSE

# Table Wellbeing
wellbeing_table <- wellbeing |> 
  pivot_longer(cols = everything(), 
               names_to = "Indikator", 
               values_to = "Nilai") |>
  filter(!is.na(Nilai)) |>
  mutate(
    Indikator = factor(Indikator, levels = c(
      "level_of_happiness", "health_status",
      "freedom_of_choice", "life_satisfaction", 
      "household_financial_satisfaction"
    )),
    Label = dplyr::recode(Indikator,
      "level_of_happiness" = "Tingkat Kebahagiaan",
      "health_status" = "Status Kesehatan Subjektif",
      "freedom_of_choice" = "Kebebasan Memilih",
      "life_satisfaction" = "Kepuasan Hidup",
      "household_financial_satisfaction" = "Kepuasan Finansial Rumah Tangga"
    ),
    Variabel = "Kesejahteraan Subjektif"
  ) |>
  group_by(Variabel, Label) |>
  summarise(
    Mean = round(mean(Nilai), 2),
    SD = round(sd(Nilai), 2),
    Min = min(Nilai),
    Max = max(Nilai),
    .groups = "drop"
  ) |> arrange(desc(Mean))

{r}
#| warning: FALSE
#| echo: FALSE
#| output: TRUE
#| tbl-cap: "Statistik Deskriptif Kesejahteraan Sosial Responden"
#| label: tbl-2

# Flextable Wellbeing
ft_wellbeing <- flextable(wellbeing_table) |>
  set_header_labels(
    Variabel = "Variabel", 
    Label = "Indikator", 
    Mean = "Mean", 
    SD = "SD", 
    Min = "Min", 
    Max = "Max"
  ) |>
  merge_v(j = "Variabel") |>
  set_table_properties(layout = "autofit", width = 0.95)

ft_wellbeing

Berdasarkan @tbl-2 yang menyajikan indikator-indikator kesejahteraan sosial, terlihat variasi yang cukup signifikan antar indikator yang diukur. Indikator kebebasan memilih menunjukkan skor rata-rata tertinggi, yang diartikan bahwa responden merasa memiliki kebebasan yang tinggi dalam membuat keputusan di hidup mereka. Sebaliknya, indikator tingkat kebahagiaan mencatat skor rata-rata terendah, menunjukkan kondisi emosional yang kurang bahagia. Temuan ini mengungkap fenomena paradoks bahwa meskipun responden merasakan kebebasan dalam menentukan arah hidup mereka, hal itu tidak berkorelasi dengan tingkat kebahagiaan yang tinggi.

